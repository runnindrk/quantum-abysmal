#include "public/QuantumAbysmalTypes.hpp"

// ================================================================================================
// Lattice hopping structure

struct Hopping
{
    int8_t latticeHop[3];
    uint8_t orbitalHop[2];
    double hoppingStrength{};
};

// ================================================================================================
// Auto-generated lattice structure

struct LatticeStructure
{
    // --------------------------------------------------------------------------------------------
    // Lattice information

    uint32_t dimension = {{ dimension }};
    uint32_t numberOfOrbitals = {{ num_orbitals }};
    uint32_t latticeSize[3] = {};
    uint64_t numberOfSites{1};
    uint64_t hamiltonianSize{1};

    Hopping hoppings[{{ hoppings|length }}] = 
    {
        {%- for hop in hoppings %}
        { 
            { {{ hop.latticeHop[0] }}, {{ hop.latticeHop[1] }}, {{ hop.latticeHop[2] }} }, 
            { {{ hop.orbitalHop[0] }}, {{ hop.orbitalHop[1] }} }, 
            {{ "%.17g"|format(hop.hoppingStrength) }}
        }
        {%- if not loop.last %},{% endif %}
        {%- endfor %}
    };

    uint8_t numberOfHoppings = {{ hoppings|length }};

    double minEnergy{};
    double maxEnergy{};
    double energyScaling{};
    double energyShift{};

    BoundaryType boundaryType{};

    // --------------------------------------------------------------------------------------------
    // Ghosted lattice information

    uint32_t ghostedLatticeSize[3] = {};
    uint32_t numberOfGhosts{};
};