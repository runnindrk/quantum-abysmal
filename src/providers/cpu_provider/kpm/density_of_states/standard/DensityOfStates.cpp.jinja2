void DensityOfStatesCpuStandard::InitializeKpmVectors(double* a, double* b, double* m, uint32_t iteration)
{
    double firstMoment{0};
    double secondMoment{0};

    // --------------------------------------------------------------------------------------------
    // Update ghosts before computation

    // UpdateGhosts(a);
    // UpdateGhosts(b);

    // ============================================================================================
    // Jinja2 unrolled code generation for hoppings
    // This is a performance optimization to avoid the overhead of a loop in the kernel.
    
    {%- if dimension == 1 %}

    // --------------------------------------------------------------------------------------------
    // Dimension 1 specific code

    #pragma omp parallel reduction(+:firstMoment, secondMoment)
    {
        uint32_t threadId = omp_get_thread_num();
        uint64_t xBlock = threadId;

        uint64_t xInitIdx = xBlock * (xSize / xDomainDecomposition) + 1;
        uint64_t xEndIdx = xInitIdx + (xSize / xDomainDecomposition);

        for (uint64_t x = xInitIdx; x < xEndIdx; x++)
        {
            // --------------------------------------------------------------------------------
            // Jinja2 unrolled code generation for hoppings
            // This is a performance optimization to avoid the overhead of a loop in the kernel.

            // Hopping terms
            {%- for hop in hoppings %}
            b[ARRAY_IDX_1D(x, 0, {{ hop.orbitalHop[0] }})] += mLattice.hoppings[{{ hop.macro_idx }}].hoppingStrength * a[ARRAY_IDX_1D(x, {{ hop.latticeHop[0] }}, {{ hop.orbitalHop[1] }})];
            {%- endfor %}

            // First moment
            {%- for i in range(num_orbitals) %}
            firstMoment += a[ARRAY_IDX_1D(x, 0, {{ i }})] * a[ARRAY_IDX_1D(x, 0, {{ i }})];
            {%- endfor %}

            // Second moment
            {%- for i in range(num_orbitals) %}
            secondMoment += b[ARRAY_IDX_1D(x, 0, {{ i }})] * a[ARRAY_IDX_1D(x, 0, {{ i }})];
            {%- endfor %}
        }
    }

    {%- elif dimension == 2 %}

    // --------------------------------------------------------------------------------------------
    // Dimension 2 specific code

    // clang-format off
    #pragma omp parallel reduction(+:firstMoment, secondMoment)
    // clang-format on
    {
        uint32_t threadId = omp_get_thread_num();
        uint32_t xBlock = threadId / xDomainDecomposition;
        uint32_t yBlock = threadId % yDomainDecomposition;

        uint64_t xInitIdx = xBlock * (xSize / xDomainDecomposition) + 1;
        uint64_t xEndIdx = xInitIdx + (xSize / xDomainDecomposition);
        uint64_t yInitIdx = yBlock * (ySize / yDomainDecomposition) + 1;
        uint64_t yEndIdx = yInitIdx + (ySize / yDomainDecomposition);

        for (uint64_t y = yInitIdx; y < yEndIdx; y++)
        {
            for (uint64_t x = xInitIdx; x < xEndIdx; x++)
            {
                // --------------------------------------------------------------------------------
                // Jinja2 unrolled code generation for hoppings
                // This is a performance optimization to avoid the overhead of a loop in the kernel.

                // Hopping terms
                {%- for hop in hoppings %}
                b[ARRAY_IDX_2D(x, y, 0, 0, {{ hop.orbitalHop[0] }})] += mLattice.hoppings[{{ hop.macro_idx }}].hoppingStrength * a[ARRAY_IDX_2D(x, y, {{ hop.latticeHop[0] }}, {{ hop.latticeHop[1] }}, {{ hop.orbitalHop[1] }})];
                {%- endfor %}

                // First moment
                {%- for i in range(num_orbitals) %}
                firstMoment += a[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})] * a[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})];
                {%- endfor %}

                // Second moment
                {%- for i in range(num_orbitals) %}
                secondMoment += b[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})] * a[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})];
                {%- endfor %}
            }
        }
    }

    {%- elif dimension == 3 %}

    // --------------------------------------------------------------------------------------------
    // Dimension 3 specific code

    #pragma omp parallel reduction(+:firstMoment, secondMoment)
    {
        uint32_t threadId = omp_get_thread_num();
        uint32_t xBlock = threadId % xDomainDecomposition;
        uint32_t yBlock = (threadId / xDomainDecomposition) % yDomainDecomposition;
        uint32_t zBlock = threadId / (xDomainDecomposition * yDomainDecomposition);

        uint64_t xInitIdx = xBlock * (xSize / xDomainDecomposition) + 1;
        uint64_t xEndIdx  = xInitIdx + (xSize / xDomainDecomposition);
        uint64_t yInitIdx = yBlock * (ySize / yDomainDecomposition) + 1;
        uint64_t yEndIdx  = yInitIdx + (ySize / yDomainDecomposition);
        uint64_t zInitIdx = zBlock * (zSize / zDomainDecomposition) + 1;
        uint64_t zEndIdx  = zInitIdx + (zSize / zDomainDecomposition);

        for (uint64_t z = zInitIdx; z < zEndIdx; z++)
        {
            for (uint64_t y = yInitIdx; y < yEndIdx; y++)
            {
                for (uint64_t x = xInitIdx; x < xEndIdx; x++)
                {
                    // --------------------------------------------------------------------------------
                    // Jinja2 unrolled code generation for hoppings
                    // This is a performance optimization to avoid the overhead of a loop in the kernel.

                    // Hopping terms
                    {%- for hop in hoppings %}
                    b[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ hop.orbitalHop[0] }})] += mLattice.hoppings[{{ hop.macro_idx }}].hoppingStrength * a[ARRAY_IDX_3D(x, y, z, {{ hop.latticeHop[0] }}, {{ hop.latticeHop[1] }}, {{ hop.latticeHop[2] }}, {{ hop.orbitalHop[1] }})];
                    {%- endfor %}

                    // First moment
                    {%- for i in range(num_orbitals) %}
                    firstMoment += a[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})] * a[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})];
                    {%- endfor %}

                    // Second moment
                    {%- for i in range(num_orbitals) %}
                    secondMoment += b[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})] * a[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})];
                    {%- endfor %}
                }
            }
        }
    }

    {%- endif %}

    // --------------------------------------------------------------------------------------------
    // Trick to halve the number of vector updates.

    m[2 * iteration] = firstMoment / mLattice.hamiltonianSize;
    m[2 * iteration + 1] = secondMoment / mLattice.hamiltonianSize;
}

void DensityOfStatesCpuStandard::ExecuteKpmVectorUpdate(double* a, double* b, double* m, uint32_t iteration)
{
    double firstMoment{0};
    double secondMoment{0};

    // --------------------------------------------------------------------------------------------
    // Update ghosts before computation

    // UpdateGhosts(a);
    // UpdateGhosts(b);

    // ============================================================================================
    // Jinja2 unrolled code generation for hoppings and orbitals
    // This is a performance optimization to avoid the overhead of a loop in the kernel.
    
    {%- if dimension == 1 %}

    // --------------------------------------------------------------------------------------------
    // Dimension 1 specific code

    #pragma omp parallel reduction(+:firstMoment, secondMoment)
    {
        uint32_t threadId = omp_get_thread_num();
        uint64_t xBlock = threadId;

        uint64_t xInitIdx = xBlock * (xSize / xDomainDecomposition) + 1;
        uint64_t xEndIdx = xInitIdx + (xSize / xDomainDecomposition);

        for (uint64_t x = xInitIdx; x < xEndIdx; x++)
        {
            double temp[{{ num_orbitals }}] = {};

            // Hopping terms
            {%- for hop in hoppings %}
            temp[{{ hop.orbitalHop[0] }}] += mLattice.hoppings[{{ hop.macro_idx }}].hoppingStrength * b[ARRAY_IDX_1D(x, {{ hop.latticeHop[0] }}, {{ hop.orbitalHop[1] }})];
            {%- endfor %}

            // Output update
            {%- for i in range(num_orbitals) %}
            a[ARRAY_IDX_1D(x, 0, {{ i }})] = 2 * temp[{{ i }}] - a[ARRAY_IDX_1D(x, 0, {{ i }})];
            {%- endfor %}

            // First moment
            {%- for i in range(num_orbitals) %}
            firstMoment += b[ARRAY_IDX_1D(x, 0, {{ i }})] * b[ARRAY_IDX_1D(x, 0, {{ i }})];
            {%- endfor %}

            // Second moment
            {%- for i in range(num_orbitals) %}
            secondMoment += a[ARRAY_IDX_1D(x, 0, {{ i }})] * b[ARRAY_IDX_1D(x, 0, {{ i }})];
            {%- endfor %}
        }
    }

    {%- elif dimension == 2 %}

    // --------------------------------------------------------------------------------------------
    // Dimension 2 specific code

    // clang-format off
    #pragma omp parallel reduction(+:firstMoment, secondMoment)
    // clang-format on
    {
        uint32_t threadId = omp_get_thread_num();
        uint32_t xBlock = threadId / xDomainDecomposition;
        uint32_t yBlock = threadId % yDomainDecomposition;

        uint64_t xInitIdx = xBlock * (xSize / xDomainDecomposition) + 1;
        uint64_t xEndIdx = xInitIdx + (xSize / xDomainDecomposition);
        uint64_t yInitIdx = yBlock * (ySize / yDomainDecomposition) + 1;
        uint64_t yEndIdx = yInitIdx + (ySize / yDomainDecomposition);

        for (uint64_t y = yInitIdx; y < yEndIdx; y++)
        {
            for (uint64_t x = xInitIdx; x < xEndIdx; x++)
            {                
                double temp[{{ num_orbitals }}] = {};

                // Hopping terms
                {%- for hop in hoppings %}
                temp[{{ hop.orbitalHop[0] }}] += mLattice.hoppings[{{ hop.macro_idx }}].hoppingStrength * b[ARRAY_IDX_2D(x, y, {{ hop.latticeHop[0] }}, {{ hop.latticeHop[1] }}, {{ hop.orbitalHop[1] }})];
                {%- endfor %}

                // Output update
                {%- for i in range(num_orbitals) %}
                a[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})] = 2 * temp[{{ i }}] - a[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})];
                {%- endfor %}

                // First moment
                {%- for i in range(num_orbitals) %}
                firstMoment += b[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})] * b[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})];
                {%- endfor %}

                // Second moment
                {%- for i in range(num_orbitals) %}
                secondMoment += a[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})] * b[ARRAY_IDX_2D(x, y, 0, 0, {{ i }})];
                {%- endfor %}
            }
        }
    }

    {%- elif dimension == 3 %}

    // --------------------------------------------------------------------------------------------
    // Dimension 3 specific code

    #pragma omp parallel reduction(+:firstMoment, secondMoment)
    {
        uint32_t threadId = omp_get_thread_num();
        uint32_t xBlock = threadId % xDomainDecomposition;
        uint32_t yBlock = (threadId / xDomainDecomposition) % yDomainDecomposition;
        uint32_t zBlock = threadId / (xDomainDecomposition * yDomainDecomposition);

        uint64_t xInitIdx = xBlock * (xSize / xDomainDecomposition) + 1;
        uint64_t xEndIdx  = xInitIdx + (xSize / xDomainDecomposition);
        uint64_t yInitIdx = yBlock * (ySize / yDomainDecomposition) + 1;
        uint64_t yEndIdx  = yInitIdx + (ySize / yDomainDecomposition);
        uint64_t zInitIdx = zBlock * (zSize / zDomainDecomposition) + 1;
        uint64_t zEndIdx  = zInitIdx + (zSize / zDomainDecomposition);

        for (uint64_t z = zInitIdx; z < zEndIdx; z++)
        {
            for (uint64_t y = yInitIdx; y < yEndIdx; y++)
            {
                for (uint64_t x = xInitIdx; x < xEndIdx; x++)
                {
                    double temp[{{ num_orbitals }}] = {};

                    // Hopping terms
                    {%- for hop in hoppings %}
                    temp[{{ hop.orbitalHop[0] }}] += mLattice.hoppings[{{ hop.macro_idx }}].hoppingStrength * b[ARRAY_IDX_3D(x, y, z, {{ hop.latticeHop[0] }}, {{ hop.latticeHop[1] }}, {{ hop.latticeHop[2] }}, {{ hop.orbitalHop[1] }})];
                    {%- endfor %}

                    // Output update
                    {%- for i in range(num_orbitals) %}
                    a[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})] = 2 * temp[{{ i }}] - a[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})];
                    {%- endfor %}

                    // First moment
                    {%- for i in range(num_orbitals) %}
                    firstMoment += b[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})] * b[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})];
                    {%- endfor %}

                    // Second moment
                    {%- for i in range(num_orbitals) %}
                    secondMoment += a[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})] * b[ARRAY_IDX_3D(x, y, z, 0, 0, 0, {{ i }})];
                    {%- endfor %}
                }
            }
        }
    }

    {%- endif %}

    // --------------------------------------------------------------------------------------------
    // Trick to halve the number of vector updates.

    m[2 * iteration] = 2 * (firstMoment / mLattice.hamiltonianSize) - m[0];
    m[2 * iteration + 1] = 2 * (secondMoment / mLattice.hamiltonianSize) - m[1];
}

