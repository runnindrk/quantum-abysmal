// ================================================================================================
// Constructors

DensityOfStatesCpuStandard::DensityOfStatesCpuStandard()
{
    mLattice = LatticeEngineImpl::GetInstance().GetLattice();
    numOrbitals = mLattice.numberOfOrbitals;
    xSize = mLattice.latticeSize[0];
    ySize = mLattice.latticeSize[1];
    zSize = mLattice.latticeSize[1];
    xGhostedSize = xSize + 2;
    yGhostedSize = ySize + 2;
    zGhostedSize = zSize + 2;

    {%- if dimension == 1 %}
    numberOfGhosts = numOrbitals * (2);
    {%- elif dimension == 2 %}
    numberOfGhosts = numOrbitals * (2 * xSize + 2 * ySize + 4);
    {%- elif dimension == 3 %}
    numberOfGhosts = numOrbitals * (2 * xSize * ySize + 2 * xSize * zSize + 2 * ySize * zSize + 2 * xSize + 2 * ySize + 2 * zSize + 8);
    {%- endif %}
}

DensityOfStatesCpuStandard::~DensityOfStatesCpuStandard()
{
}

